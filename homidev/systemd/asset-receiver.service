# asset-receiver.service - homidev asset receiver (step 9f-1, v1.0, 1 Oct 2026)
# Install: /etc/systemd/system/asset-receiver.service
# Starts after ComfyUI, but does NOT die if ComfyUI is down (/health reports it instead).

[Unit]
Description=homidev asset receiver (port 8190)
After=network-online.target comfyui.service
Wants=network-online.target comfyui.service

[Service]
Type=simple
User=homidev
Group=homidev
WorkingDirectory=/home/homidev/receiver
ExecStart=/home/homidev/receiver/venv/bin/uvicorn receiver:app --host 0.0.0.0 --port 8190
Restart=on-failure
RestartSec=5
# small, safe hardening: the receiver can never gain extra rights, and gets its own /tmp
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
